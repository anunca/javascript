NODE_VERSION=26.1.0-alpine
NODE_IMAGE=node:${NODE_VERSION}-alpine


NODE_ENV=development
SLS_DEBUG=*

DYNAMODB_VERSION=amazon/dynamodb-local:1.20.0
DYNAMODB_TABLE=item
DYNAMODB_URL=http://localhost:8000

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=serverless-dynamodb
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
