NODE_VERSION=26.7.0
NODE_IMAGE=node:${NODE_VERSION}-alpine
MONGODB_VERSION=8.3.8
MONGODB_IMAGE=mongo:${MONGODB_VERSION}
NGINX_VERSION=1.31.4
